DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_scheduler
LINE_CHANNEL_SECRET=LINE_CHANNEL_SECRET
LINE_CHANNEL_ACCESS_TOKEN=LINE_CHANNEL_ACCESS_TOKEN
# C.4: รหัสยืนยันแอดมินเมื่อผูก LINE OA (ตัวอย่างจาก spec)
LINE_ADMIN_VERIFY_CODE=229
# C.1: base URL สำหรับลิงก์เช็คอินใน QR/LINE (เช่น https://som.develyst.online)
PUBLIC_CHECKIN_BASE_URL=https://som.develyst.online
# Public base URL for the teacher .ics calendar feed (REQ-017). Falls back to PUBLIC_CHECKIN_BASE_URL if unset.
PUBLIC_CALENDAR_BASE_URL=https://som.develyst.online
JWT_SECRET=dev-secret-change-me
TZ=Asia/Bangkok
PORT=4006

# Auth (B.7). SKIP_AUTH=true bypasses JWT in dev so the FE (not yet sending tokens)
# keeps working. Remove/false in production once the FE logs in.
SKIP_AUTH=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
JWT_TTL_SECONDS=43200

OPS_API_URL=https://backoffice-som.develyst.online
SERVICE_TOKEN=change-me-service-token
