# The Postgres this API reads and writes (postgres://user:pass@host:port/db). A dev box points at the team's DEV database; never a production one.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_scheduler
# LINE Messaging API channel secret — the webhook verifies every request's signature with it. Placeholder here; the real value comes from the owner.
LINE_CHANNEL_SECRET=LINE_CHANNEL_SECRET
# LINE Messaging API channel access token — every push/reply the bot sends. Placeholder here; the real value comes from the owner.
LINE_CHANNEL_ACCESS_TOKEN=LINE_CHANNEL_ACCESS_TOKEN
# C.4 · 🔴🔴 TASK-534 (SEC-1): the code a chat types to link as a LINE ADMIN. NO DEFAULT — min 8 chars, never 229; unset, short
# or 229 ⇒ admin linking is REFUSED (loud in the log). Never write it in any message, prompt or doc.
LINE_ADMIN_VERIFY_CODE=
# C.1: base URL สำหรับลิงก์เช็คอินใน QR/LINE (เช่น https://som.develyst.online)
PUBLIC_CHECKIN_BASE_URL=https://som.develyst.online
# Public base URL for the teacher .ics calendar feed (REQ-017). Falls back to PUBLIC_CHECKIN_BASE_URL if unset.
PUBLIC_CALENDAR_BASE_URL=https://som.develyst.online
# Signs the admin login tokens. Change it on every real box; the default is for local dev only.
JWT_SECRET=dev-secret-change-me
# The server clock zone: all day boundaries (Bangkok calendar days) assume Asia/Bangkok.
TZ=Asia/Bangkok
# The port the API listens on (the committed default is 4006).
PORT=4006

# Auth (B.7). SKIP_AUTH=true bypasses JWT in dev so the FE (not yet sending tokens)
# keeps working. Remove/false in production once the FE logs in.
SKIP_AUTH=false
# TASK-377 (REQ-092 RBAC Stage 1) — the old ADMIN_USERNAME / ADMIN_PASSWORD login is RETIRED. This pair creates
# the FIRST super admin at the first login while the `users` table is EMPTY, and is ignored once any user exists.
BOOTSTRAP_ADMIN_USERNAME=admin
# min 8 chars; read only while the users table is empty — a shorter one is REFUSED loudly (TASK-380)
BOOTSTRAP_ADMIN_PASSWORD=
# How long an admin login token lives, in seconds (604800 = 7 days).
JWT_TTL_SECONDS=604800

# Base URL of the backoffice API (revenue/sale posting). Empty ⇒ posting is skipped, never failed.
OPS_API_URL=https://backoffice-som.develyst.online
# The service token this API presents to the backoffice API when it posts a sale. Placeholder here.
SERVICE_TOKEN=change-me-service-token

# REQ-088 / TASK-347 — registration by LINK. Both values come from the CUSTOMER'S LINE Developers console.
# The server verifies every /api/register call's LIFF ID token against this Login channel; unset = every call refused.
LINE_LOGIN_CHANNEL_ID=
# The LIFF app id the page initialises with. TASK-469: the bot ALSO reads it — the Sign Up / Add Student cells reply with
# https://liff.line.me/<LIFF_ID>. Demo box = the demo OA's id, real box = the real OA's. Unset = the cells keep the typed flow.
LIFF_ID=

# Shared secret for the /internal job endpoints (end-of-day, reminders, digest). The job scripts send it as x-internal-secret; unset ⇒ the endpoints answer NOT_CONFIGURED.
INTERNAL_JOB_SECRET=

# https base address of the admin web app (no ? or #) — the LINE admin menu's link and the chat's web-app link are built from it. Unset ⇒ no link.
PUBLIC_ADMIN_BASE_URL=https://admin.example.com

# Where the scheduled job scripts (scripts/end-of-day.ts, daily-reminder.ts, daily-digest.ts) find this API. Default http://localhost:4006.
SCHEDULER_API_URL=http://localhost:4006

# Comma list of LINE OA accounts (@id) THIS checkout may write to (rich menus etc.). Empty ⇒ nothing is writable (the safe default).
LINE_OA_WRITE_ALLOW=

# scripts/smoke.ts only: the base URL of the API the smoke run calls.
BASE=http://localhost:4006
