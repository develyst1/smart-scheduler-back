# Copy to `.env` (gitignored) and fill in real values.

# Shared PostgreSQL database (both backends point at the same DB).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/smart_scheduler

# LINE Messaging API (Official Account) — server-side only, never shipped to the browser.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Auth
JWT_SECRET=

# Always run the API in the school's timezone.
TZ=Asia/Bangkok
PORT=4006
